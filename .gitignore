
# ==========================================
# Node.js Git Ignore
# ==========================================

# Dependencies
node_modules/
jspm_packages/
bower_components/

# Environment Variables & Secrets
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build Output
dist/
build/
out/
.next/
.nuxt/
.output/
.cache/
.tmp/
temp/
tmp/

# Test & Coverage
coverage/
.nyc_output/
*.lcov

# TypeScript
*.tsbuildinfo

# Runtime Files
*.pid
*.pid.lock
*.seed
pids/

# Package Manager Cache
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# OS Generated Files
.DS_Store
Thumbs.db
Desktop.ini

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace

# Local Database Files
*.sqlite
*.sqlite3
*.db

# Uploaded & Temporary Files
uploads/
temp/
tmp/

# Serverless
.serverless/
.aws-sam/

# Vercel & Netlify
.vercel/
.netlify/

# Miscellaneous
.eslintcache
.stylelintcache
*.bak
*.backup
